# Absolute Axis 設定範本：複製成 .env 後修改
#   cp .env.example .env
#
# 只有「必填」兩項一定要填；其他都是選用整合，留空＝不使用該功能（介面會顯示「未設定」）。
# .env 內含密碼與 token，不要 commit、不要貼到聊天或 issue。

# =======================================================================
# [必填] 登入金鑰與第一個管理員
# =======================================================================

# 登入金鑰（JWT 簽名用）：至少 32 字元的隨機字串，產生方式任選一種：
#   openssl rand -hex 32
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# 沒填 docker compose 會拒絕啟動；少於 32 字元程式也會拒絕啟動。換掉它會讓所有人需要重新登入。
AXIS_JWT_SECRET=

# 第一個管理員：資料庫裡還沒有任何管理員時，第一次啟動會用這組帳密建立。
# 帳號留空＝admin；登入後可到「系統設定 › 個人身分與安全密碼」改名稱與密碼。
# 已經有管理員之後，這兩個值就不再使用（改這裡不會改到現有帳號的密碼）。
AXIS_ADMIN_USER=
AXIS_ADMIN_PASS=

# =======================================================================
# [選用] 要一起啟動的附加服務（docker compose profiles），多個用逗號分隔：
#   tunnel     = Cloudflare Tunnel（需要下面的 CLOUDFLARE_TUNNEL_TOKEN）
#   minecraft  = Minecraft 伺服器容器（itzg/minecraft-server，資料在 ./minecraft-data）
# 例如：COMPOSE_PROFILES=tunnel
# =======================================================================
COMPOSE_PROFILES=

# =======================================================================
# [選用] Proxmox VE：虛擬化中心的虛擬機／LXC。PVE_HOST 留空＝不使用 Proxmox
# =======================================================================
# Proxmox 主機位址（建議填區網 IP，例如 192.168.1.10）
PVE_HOST=

# 建議：最小權限的 API token（查看、開關機與節點狀態）。在 Proxmox Shell 建立：
#   pveum role add AxisOps --privs "VM.Audit,VM.PowerMgmt,Sys.Audit"
#   pveum user add axis@pve
#   pveum user token add axis@pve axis --privsep 1        # 會顯示一次 token 值，填到下面
#   pveum acl modify /vms  --users axis@pve --tokens 'axis@pve!axis' --roles AxisOps
#   pveum acl modify /nodes --users axis@pve --tokens 'axis@pve!axis' --roles AxisOps
PVE_TOKEN_ID=
PVE_TOKEN_SECRET=
# Proxmox 叢集 CA（主機上 /etc/pve/pve-root-ca.pem 的副本）；設定後會驗證 TLS 憑證
PVE_CA_FILE=

# 開 noVNC 主控台時「瀏覽器」要連的 Proxmox 位址（例如 Tailscale IP）；留空＝同 PVE_HOST
PVE_CONSOLE_HOST=

# 「部署 VM」（走 SSH 以 root 執行 qm）才需要 root 密碼；不用這個功能就留空
PVE_USER=root@pam
PVE_PASS=
# 「部署 VM」建立磁碟用的儲存空間名稱；留空＝local-lvm
PVE_VM_STORAGE=

# =======================================================================
# [選用] DeviceHub：智慧宅控的裝置（遠端開關機、喚醒、溫濕度、告警）。DEVICEHUB_URL 留空＝不使用
# DeviceHub 是另一個專案；兩把 token 在 DeviceHub 主機上產生：
#   讀取：sh /opt/devicehub/deploy/hub/new-read-token.sh axis <這台主機的區網 IP>
#   控制：sh /opt/devicehub/deploy/hub/new-control-token.sh axis <這台主機的區網 IP>
# 控制 token 留空＝只顯示狀態、不能控制。
# =======================================================================
DEVICEHUB_URL=
DEVICEHUB_TOKEN=
DEVICEHUB_CONTROL_TOKEN=

# =======================================================================
# [選用] Minecraft 模組（多重宇宙）：連到另一台跑 Minecraft 的主機（LXC／VM）。MC_HOST 留空＝不使用
# =======================================================================
MC_HOST=
# 伺服器連接埠；留空＝25565
MC_PORT=
# 玩家從外面連線用的網域（例如 DDNS 網域）；留空＝不顯示
MC_PUBLIC_HOST=
# 在那台主機上執行指令用的 SSH 帳密（用內建容器時不需要）
MC_SSH_USER=root
MC_SSH_PASS=
# 用下面的內建 Minecraft 容器時填 axis-mc（並把 MC_HOST 設成 127.0.0.1）：
# 多重宇宙頁的「送指令」走容器內的 rcon-cli，「切換模組包」直接換 MC_SERVER_PACK 那個 zip，不用 SSH。
# 切換時每個模組包的世界各自保存在 ./minecraft-data/.axis-worlds/；
# 模組包的 Minecraft 版本要和 MC_VERSION 相同，不同就先改 MC_VERSION／MC_FORGE_VERSION 再重建容器
MC_CONTAINER=

# COMPOSE_PROFILES 含 minecraft 時，內建 Minecraft 容器（itzg/minecraft-server:java17）用的設定：
#   MC_TYPE          伺服器類型：FORGE／FABRIC／VANILLA…（留空＝FORGE）
#   MC_VERSION       Minecraft 版本，例如 1.20.1（留空＝最新版）
#   MC_FORGE_VERSION Forge 版本，例如 47.4.16（留空＝該 Minecraft 版本的建議版）
#   MC_SERVER_PACK   伺服器包 zip 在容器內的路徑：把 zip 放到 ./minecraft-data/ 後填 /data/檔名.zip
MC_TYPE=
MC_VERSION=
MC_FORGE_VERSION=
MC_SERVER_PACK=
#   MC_LEVEL         世界資料夾名稱（留空＝world）
MC_LEVEL=
#   MC_MEMORY_LIMIT  容器記憶體上限，例如 12G（留空＝10.5G）。Java 堆積上限固定 9G，
#                    其餘留給 Java 本身；大型模組包被系統砍掉（OOM）時調高這個值
MC_MEMORY_LIMIT=

# =======================================================================
# [選用] 其他外部服務
# =======================================================================
# Cloudflare Tunnel：從外面連線（還要在 COMPOSE_PROFILES 加上 tunnel）
CLOUDFLARE_TUNNEL_TOKEN=
# GitHub 個人存取權杖：提高 GitHub API 次數上限（開源分享、版本資訊）；不填也能用
GITHUB_TOKEN=
# Blynk 溫濕度感測器（舊版智慧宅控）
BLYNK_TOKEN=

# =======================================================================
# [選用] 網路
# =======================================================================
# 需要跨來源存取 API 時列出允許的網域，多個用逗號分隔；留空＝不允許（同網域的前端不受影響）。不要用 *
ALLOWED_ORIGINS=
# 監聽位址：0.0.0.0＝所有介面
HOST_IP=0.0.0.0

# 以下三項只在「不用 Docker、直接執行」時才需要；用 docker compose 時由 docker-compose.yml 決定
# AXIS_BASE_PATH=
# AXIS_NAS_PATH=
# AXIS_SYS_ROOT=/

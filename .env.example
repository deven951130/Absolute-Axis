# 部署至新主機時，請將此檔案複製為 .env 並填入所有正確數值
# cp .env.example .env

# -----------------------------------------------------------------------
# [必填] 安全憑證 - 請勿使用預設值，必須自行產生隨機字串
# -----------------------------------------------------------------------

# JWT 簽名密鑰：請使用 `python -c "import secrets; print(secrets.token_hex(32))"` 產生
# 必填：docker compose 沒有它會拒絕啟動；少於 32 字元程式也會拒絕啟動。
# 換掉這個值會讓所有人需要重新登入（正常現象）。
AXIS_JWT_SECRET=<請填入 64 字元以上的隨機字串>

# 管理員初始密碼：首次啟動服務時會以此建立 sparkle 帳號
AXIS_ADMIN_PASS=<請填入管理員初始密碼>

# -----------------------------------------------------------------------
# [必填] Proxmox VE 連線設定
# -----------------------------------------------------------------------
PVE_HOST=192.168.0.138

# 建議：最小權限的 API token（設定後，API 呼叫不再使用 root 密碼）
# 在 Proxmox Shell 建立（權限只含查看、開關機與節點狀態）：
#   pveum role add AxisOps --privs "VM.Audit,VM.PowerMgmt,Sys.Audit"
#   pveum user add axis@pve
#   pveum user token add axis@pve axis --privsep 1        # 會顯示一次 token 值，填到下面
#   pveum acl modify /vms  --users axis@pve --tokens 'axis@pve!axis' --roles AxisOps
#   pveum acl modify /nodes --users axis@pve --tokens 'axis@pve!axis' --roles AxisOps
PVE_TOKEN_ID=axis@pve!axis
PVE_TOKEN_SECRET=<請填入 token 值>
# 選填：Proxmox 叢集 CA（主機上 /etc/pve/pve-root-ca.pem 的副本），設定後會驗證 TLS 憑證
PVE_CA_FILE=

# 舊方式（root 密碼）：只剩「部署 VM」（/api/proxmox/deploy，走 SSH）還需要；不用這個功能可以留空
PVE_USER=root@pam
PVE_PASS=

# Minecraft 容器的 SSH 帳密（原本寫死在程式碼裡）
MC_SSH_USER=root
MC_SSH_PASS=

# -----------------------------------------------------------------------
# [必填] IoT 與外部服務 Token
# -----------------------------------------------------------------------
BLYNK_TOKEN=<請填入 Blynk IoT Token>
GITHUB_TOKEN=<請填入 GitHub Personal Access Token>
CLOUDFLARE_TUNNEL_TOKEN=<請填入 Cloudflare Tunnel Token>

# -----------------------------------------------------------------------
# [選填] DeviceHub 唯讀模組（智慧宅控 → 🛰️ DeviceHub 頁籤，只有管理員看得到）
# token 在 DeviceHub 容器內產生：sh /opt/devicehub/deploy/hub/new-read-token.sh axis <本機 IP>
# 內容在 /root/devicehub-secrets/read-token-axis.txt；只放在這裡，不要貼到別處。
# -----------------------------------------------------------------------
DEVICEHUB_URL=http://192.168.0.50:8080
DEVICEHUB_TOKEN=

# -----------------------------------------------------------------------
# [選填] 網路與路徑設定
# -----------------------------------------------------------------------

# API 監聽 IP：0.0.0.0 表示監聽所有介面
HOST_IP=0.0.0.0

# CORS 允許來源：多個來源用逗號分隔；留空＝不允許任何跨來源請求（同網域前端不受影響）。不要用 *
ALLOWED_ORIGINS=https://absoluteaxis.dpdns.org

# 專案根路徑：留空則自動偵測
AXIS_BASE_PATH=

# NAS 儲存路徑：留空則使用 AXIS_BASE_PATH/nas
AXIS_NAS_PATH=

# 系統根路徑（用於磁碟計算）：Linux 填 /，Windows 填 C:\
AXIS_SYS_ROOT=/
